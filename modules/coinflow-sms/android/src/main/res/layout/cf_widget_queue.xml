<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/cf_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="14dp"
  android:background="@drawable/cf_widget_bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="To review"
      android:textColor="@color/cf_widget_text2"
      android:textSize="13sp"
      android:fontFamily="sans-serif-medium" />
    <TextView
      android:id="@+id/cf_count"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/cf_widget_pill"
      android:paddingHorizontal="8dp"
      android:paddingVertical="1dp"
      android:textColor="@color/cf_widget_text"
      android:textSize="12sp"
      android:fontFamily="sans-serif-medium"
      android:visibility="gone" />
  </LinearLayout>

  <TextView
    android:id="@+id/cf_empty"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center"
    android:textColor="@color/cf_widget_text2"
    android:textSize="14sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/cf_row1"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">
    <TextView
      android:id="@+id/cf_row1_arrow"
      android:layout_width="18dp"
      android:layout_height="wrap_content"
      android:textColor="@color/cf_widget_text3"
      android:textSize="14sp" />
    <TextView
      android:id="@+id/cf_row1_label"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/cf_widget_text"
      android:textSize="14sp" />
    <TextView
      android:id="@+id/cf_row1_amount"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:textColor="@color/cf_widget_text"
      android:textSize="14sp"
      android:fontFamily="sans-serif-medium" />
  </LinearLayout>
  <LinearLayout
    android:id="@+id/cf_row2"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">
    <TextView
      android:id="@+id/cf_row2_arrow"
      android:layout_width="18dp"
      android:layout_height="wrap_content"
      android:textColor="@color/cf_widget_text3"
      android:textSize="14sp" />
    <TextView
      android:id="@+id/cf_row2_label"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/cf_widget_text"
      android:textSize="14sp" />
    <TextView
      android:id="@+id/cf_row2_amount"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:textColor="@color/cf_widget_text"
      android:textSize="14sp"
      android:fontFamily="sans-serif-medium" />
  </LinearLayout>
  <LinearLayout
    android:id="@+id/cf_row3"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">
    <TextView
      android:id="@+id/cf_row3_arrow"
      android:layout_width="18dp"
      android:layout_height="wrap_content"
      android:textColor="@color/cf_widget_text3"
      android:textSize="14sp" />
    <TextView
      android:id="@+id/cf_row3_label"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/cf_widget_text"
      android:textSize="14sp" />
    <TextView
      android:id="@+id/cf_row3_amount"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:textColor="@color/cf_widget_text"
      android:textSize="14sp"
      android:fontFamily="sans-serif-medium" />
  </LinearLayout>

  <TextView
    android:id="@+id/cf_more"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textColor="@color/cf_widget_text3"
    android:textSize="12sp"
    android:visibility="gone" />
</LinearLayout>
