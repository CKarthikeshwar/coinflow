{
  "expo": {
    "name": "coinflow",
    "slug": "coinflow",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coinflow",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.ckworkforce.coinflow",
      "userInterfaceStyle": "dark",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.WRITE_CONTACTS"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#F5F5F2"
        }
      ],
      "./modules/coinflow-sms/app.plugin.js",
      "./plugins/with-android-signing.js",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-sharing",
      [
        "expo-contacts",
        {
          "contactsPermission": "CoinFlow reads your contacts only when you choose someone to split with. Nothing is copied except the name and number you pick."
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "ck",
          "project": "coinflow",
          "url": "https://sentry.io/"
        }
      ],
      "expo-image",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "sentryDsn": "https://1d33a0704f01e73edea24b567f1f2e76@o4512026358644736.ingest.de.sentry.io/4512026371096656",
      "eas": {
        "projectId": "0e6d47a3-fd84-4e49-b09b-0c911040a284"
      }
    },
    "owner": "ck-workforce"
  }
}
