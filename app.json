{
  "expo": {
    "name": "coinflow",
    "slug": "coinflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coinflow",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.ckworkforce.coinflow",
      "userInterfaceStyle": "dark",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      "./modules/coinflow-sms/app.plugin.js",
      "./plugins/with-android-signing.js",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-sharing",
      [
        "@sentry/react-native",
        {
          "organization": "ck",
          "project": "coinflow",
          "url": "https://sentry.io/"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "sentryDsn": "https://1d33a0704f01e73edea24b567f1f2e76@o4512026358644736.ingest.de.sentry.io/4512026371096656",
      "eas": {
        "projectId": "0e6d47a3-fd84-4e49-b09b-0c911040a284"
      }
    },
    "owner": "ck-workforce"
  }
}
