# Files EAS Build should NOT upload. Same syntax as .gitignore.
# When this file exists, EAS uses it INSTEAD of .gitignore, so the
# real build-irrelevant entries from .gitignore are repeated here.

# --- from .gitignore ---
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo
coverage/
example
/ios
/android

# --- AI / editor tooling (contains the Windows junction that breaks upload) ---
.claude/
.agents/
.codex/
.impeccable/
.vscode/
.cursor/
skills-lock.json

# --- docs & design assets — not needed to build the app ---
SPEC/
SPEC-implementation.md
SPEC-UI-UX.md
design-prototype/
design-references/
docs/
*.md
!README.md

# --- local scratch ---
dist-web/
dist-android/
